# Application Mode (set to false only when you are ready to send live emails)
DRY_RUN=true
DEBUG=false
OUTBOX_DIR=outbox

# SMTP Email Credentials (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SENDER_NAME=Rohit Raj Gupta
SENDER_EMAIL=your_email@gmail.com

# AI Provider (Optional: supports OpenAI or OpenAI-compatible endpoints like Gemini or Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Enrichment APIs (Optional)
HUNTER_API_KEY=
APOLLO_API_KEY=
